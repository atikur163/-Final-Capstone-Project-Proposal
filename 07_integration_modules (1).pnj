---
title: 7. Integration Modules (QR and Face)
---
classDiagram
    class QRTokenService {
        +generate_token(int session_id) QRSessionToken
        +render_qr(string token) image
        +validate(string token, int student_id) bool
    }
    class FaceRecognizer {
        <<interface>>
        +embed(bytes image) List~float~
        +compare(List~float~ embedding, List~float~ stored) float
    }
    class OnnxFaceRecognizer {
        +string model_path
        +float threshold
        +embed(bytes image) List~float~
        +compare(List~float~ embedding, List~float~ stored) float
    }
    class FaceService {
        +register(int student_id, bytes image) FaceProfile
        +verify(int session_id, int student_id, bytes image) bool
    }
    class AttendanceEngine
    class QRSessionToken
    class FaceProfile
    class FaceVerificationLog

    FaceRecognizer <|.. OnnxFaceRecognizer
    FaceService ..> FaceRecognizer
    FaceService ..> FaceProfile
    FaceService ..> FaceVerificationLog
    FaceService ..> AttendanceEngine
    QRTokenService ..> QRSessionToken
    QRTokenService ..> AttendanceEngine
